// The 2.0 dashboard on app.amelu.org (and beta.amelu.org): static files only, no Worker code.
// Deploy with `pnpm deploy:beta` from the repo root (builds, then uploads).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amelu-beta",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist/beta/browser",
    // Client-side routes (/domains, /login, ...) all serve index.html.
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "app.amelu.org", "custom_domain": true },
    { "pattern": "beta.amelu.org", "custom_domain": true }
  ]
}
