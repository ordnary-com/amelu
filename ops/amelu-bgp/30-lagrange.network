[Match]
Name=lagrange

[Network]
Address=10.243.218.2/30
Address=fd:6fa2::2/64
LinkLocalAddressing=no
ConfigureWithoutCarrier=yes

# Traffic from our own prefixes leaves through Lagrange; everything else uses Hetzner.
[Route]
Gateway=10.243.218.1
Table=100

[Route]
Gateway=fd:6fa2::1
Table=100

[RoutingPolicyRule]
From=89.106.70.0/24
Table=100
Priority=100

[RoutingPolicyRule]
From=2a06:9801:f90::/48
Table=100
Priority=100

# Traffic between addresses in our own block (router .1 <-> marduk) stays local.
[RoutingPolicyRule]
To=89.106.70.0/24
Table=main
Priority=90
