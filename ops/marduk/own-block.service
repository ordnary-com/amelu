[Unit]
Description=Policy routing for our own block 89.106.70.0/24 (exits via the Vultr routers)
Before=wg-quick@vultr.service wg-quick@par.service bgp-exit-check.service
After=network-online.target
Wants=network-online.target

# Traffic from 89.106.70.0/24 uses table 30, whose default routes point at
# rtr1-ams (wg-quick@vultr) and rtr1-par (wg-quick@par); bgp-exit-check keeps
# them in line. 89.106.70.2 is the test address. Used to live in the Lagrange
# tunnel (wg-quick@bgp), removed with rtr1-nbg on 2026-11-17.
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c "ip rule show | grep -q \"from 89.106.70.0/24 lookup 30\" || ip rule add from 89.106.70.0/24 lookup 30 priority 100"
ExecStart=/bin/sh -c "ip addr show dev lo | grep -q 89.106.70.2/32 || ip addr add 89.106.70.2/32 dev lo"
ExecStop=/sbin/ip rule del from 89.106.70.0/24 lookup 30 priority 100
ExecStop=/sbin/ip addr del 89.106.70.2/32 dev lo

[Install]
WantedBy=multi-user.target
