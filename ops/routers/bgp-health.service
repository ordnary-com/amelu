[Unit]
Description=BGP health endpoint for ordnary.com/status (port 9180, /healthz)
After=network-online.target bird.service
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/default/bgp-health
ExecStart=/usr/bin/python3 /usr/local/bin/bgp-health
# Reads BIRD's control socket (group bird) and nothing else.
DynamicUser=yes
SupplementaryGroups=bird
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
